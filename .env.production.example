# Copy to .env.production and replace every placeholder before deployment.
ENVIRONMENT=production
DEBUG=false
DEMO_MODE=false
REQUIRE_AUTHENTICATION=true
JWT_SECRET_KEY=generate-a-64-character-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=https://crime.example.com
POSTGRES_DSN=postgresql+asyncpg://nexus:replace-me@postgres:5432/nexus
POSTGRES_PASSWORD=replace-me
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace-me
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=case_reports
WEB3_RPC_URL=https://your-rpc-provider.example
WEB3_CHAIN_ID=1
EVIDENCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
EVIDENCE_ANCHOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_PRIVATE_KEY=never-commit-this
OPENAI_API_KEY=never-commit-this
TLS_CERT_PATH=./secrets/tls.crt
TLS_KEY_PATH=./secrets/tls.key
