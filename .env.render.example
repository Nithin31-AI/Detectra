# =============================================================================
# DETECTRA — Render Production Environment Variable Mapping Reference
# =============================================================================
# This file serves as an environment template when configuring services manually
# or reviewing variables injected automatically via `render.yaml`.

# -----------------------------------------------------------------------------
# 1. DATABASE & CACHE CONNECTIONS (Render Managed & Service Discovery)
# -----------------------------------------------------------------------------
# Injected via Render Managed Postgres (fromDatabase: nexus_ai property: connectionString)
POSTGRES_DSN=postgresql+asyncpg://nexus:<password>@dpg-<id>-a.render.com/nexus

# Injected via Render Managed Redis (fromService: sih-redis property: connectionString)
REDIS_URL=redis://red-<id>:6379/0
CELERY_BROKER_URL=redis://red-<id>:6379/1
CELERY_RESULT_BACKEND=redis://red-<id>:6379/2

# Private Database Container Connections (Internal DNS)
NEO4J_URI=bolt://sih-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_AUTH=neo4j/change-me

QDRANT_URL=http://sih-qdrant:6333

# -----------------------------------------------------------------------------
# 2. FASTAPI BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
# Dynamic Port injected by Render for Web Services (Defaults to 10000)
PORT=10000
HOST=0.0.0.0

# CORS Allowed Origins (JSON Array String)
CORS_ORIGINS=["https://sih-frontend.onrender.com"]

# Security & Authentication Secrets
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# 3. OPTIONAL AI & LLM PROVIDER KEYS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# 4. FRONTEND ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Points the React SPA build to the public URL of the Render FastAPI backend
VITE_API_BASE_URL=https://sih-backend.onrender.com/api/v1
