APP_NAME=Nexus Crime AI API
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
REQUIRE_AUTHENTICATION=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database & Storage Services (Updated for Docker Network)
POSTGRES_DSN=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=case_reports
QDRANT_API_KEY=

# Blockchain Configuration
WEB3_RPC_URL=
EVIDENCE_ANCHOR_CONTRACT_ADDRESS=
EVIDENCE_CONTRACT_ADDRESS=
EVIDENCE_ANCHOR_CONTRACT_ABI=
WEB3_CHAIN_ID=1

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2